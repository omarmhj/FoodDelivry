# SnackRapido Environment Configuration for Docker
# Copy this file to .env and update the values

# Database Configuration
DATABASE_URL="mongodb://admin:password123@localhost:27017/snackrapido?authSource=admin"
MONGODB_URI="mongodb://admin:password123@localhost:27017/snackrapido?authSource=admin"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_URL="redis://:redis123@localhost:6379"

# RabbitMQ Configuration
RABBITMQ_URL="amqp://admin:rabbit123@localhost:5672"
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbit123
RABBITMQ_VHOST=/

# JWT Configuration
JWT_SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
ACCESS_TOKEN_SECRET="your-access-token-secret-change-this-in-production"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-change-this-in-production"
ACTIVATION_TOKEN_SECRET="your-activation-token-secret-change-this-in-production"

# Email Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="SnackRapido <noreply@snackrapido.com>"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Service Ports
API_GATEWAY_PORT=4000
API_USERS_PORT=4001
API_RESTAURANTS_PORT=4002

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Environment
NODE_ENV=development
