@startuml Medical Exam Platform - Final Class Diagram

' ============================================
' CORE ENTITIES
' ============================================

class User {
  - id: string
  - email: string
  - passwordHash: string
  - name: string
  - university: University
  - yearOfStudy: number
  - subscriptionTier: SubscriptionTier
  - profileImage: string
  - isActive: boolean
  - createdAt: Date
  - updatedAt: Date
  --
  + register(): void
  + login(): string
  + updateProfile(): void
  + getProgress(): UserProgress
  + getSubscription(): Subscription
}

enum SubscriptionTier {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum University {
  TUNIS
  SOUSSE
  MONASTIR
  SFAX
  OTHER
}

class Subscription {
  - id: string
  - userId: string
  - tier: SubscriptionTier
  - startDate: Date
  - endDate: Date
  - isActive: boolean
  - autoRenew: boolean
  - paymentMethod: string
  --
  + renew(): void
  + cancel(): void
  + upgrade(): void
  + isExpired(): boolean
}

' ============================================
' SERIES STRUCTURE
' ============================================

class Specialty {
  - id: string
  - name: string
  - slug: string
  - description: string
  - iconUrl: string
  - totalTopics: number
  - totalSeries: number
  - orderIndex: number
  --
  + getTopics(): Topic[]
  + getCourses(): Course[]
  + getStatistics(): SpecialtyStats
}

class Topic {
  - id: string
  - specialtyId: string
  - name: string
  - slug: string
  - description: string
  - orderIndex: number
  - totalSeries: number
  - estimatedStudyHours: number
  --
  + getSeries(): Series[]
  + getHistoricalSeries(): Series[]
  + getAIGeneratedSeries(): Series[]
  + getCourses(): Course[]
}

class Series {
  - id: string
  - topicId: string
  - title: string
  - seriesType: SeriesType
  - university: University
  - year: number
  - difficulty: Difficulty
  - totalQuestions: number
  - durationMinutes: number
  - isPublished: boolean
  - needsRegeneration: boolean
  - outdatedSince: Date
  - createdAt: Date
  --
  + getQuestions(): Question[]
  + calculateScore(answers): number
  + getStatistics(): SeriesStats
  + markForRegeneration(): void
}

enum SeriesType {
  HISTORICAL
  AI_GENERATED
  AI_PROGRESSIVE
}

' ============================================
' EXAM DOMAIN
' ============================================

class Exam {
  - id: string
  - title: string
  - examType: ExamType
  - specialtyId: string
  - university: University
  - year: number
  - durationMinutes: number
  - totalQuestions: number
  - passingScore: number
  - difficulty: Difficulty
  - isPublished: boolean
  - createdAt: Date
  --
  + getQuestions(): Question[]
  + calculateScore(answers): number
  + validateAttempt(): boolean
  + getStatistics(): ExamStats
}

enum ExamType {
  CONCOURS_RESIDANAT
  PRACTICE_EXAM
  MOCK_EXAM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

' ============================================
' QUESTIONS & ANSWERS WITH COURSE REFERENCES
' ============================================

class Question {
  - id: string
  - parentId: string
  - parentType: QuestionParentType
  - questionText: string
  - questionType: QuestionType
  - imageUrl: string
  - difficulty: Difficulty
  - tags: string[]
  - orderIndex: number
  - points: number
  --
  + getAnswers(): Answer[]
  + validateAnswer(userAnswer): boolean
  + getCorrectAnswers(): Answer[]
  + getCourseReferences(): QuestionCourseReference[]
}

enum QuestionParentType {
  SERIES
  EXAM
  AI_GENERATED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

class Answer {
  - id: string
  - questionId: string
  - answerText: string
  - isCorrect: boolean
  - orderIndex: number
  --
  + validate(): boolean
  + getExplanation(): AnswerExplanation
}

class AnswerExplanation {
  - id: string
  - questionId: string
  - answerId: string
  - explanationText: string
  - isCorrectExplanation: boolean
  - generatedBy: GenerationSource
  - createdAt: Date
  --
  + getCourseReferences(): CourseReference[]
}

enum GenerationSource {
  AI_BATCH
  MANUAL
  HYBRID
}

class QuestionCourseReference {
  - id: string
  - questionId: string
  - courseId: string
  - sectionId: string
  - relevanceScore: number
  - referenceType: ReferenceType
  - createdAt: Date
  --
  + getCourseSection(): CourseSection
}

enum ReferenceType {
  EXPLANATION
  CONTEXT
  RELATED
  PREREQUISITE
}

' ============================================
' COURSE DOMAIN WITH SECTIONS
' ============================================

class Course {
  - id: string
  - specialtyId: string
  - topicId: string
  - title: string
  - description: string
  - contentType: ContentType
  - fileUrl: string
  - thumbnailUrl: string
  - version: number
  - lastUpdated: Date
  - embeddingsGenerated: boolean
  - isPublished: boolean
  --
  + getSections(): CourseSection[]
  + getProgress(userId): CourseProgress
  + updateContent(content): void
  + triggerRegeneration(): void
}

enum ContentType {
  PDF
  VIDEO
  TEXT
  INTERACTIVE
}

class CourseSection {
  - id: string
  - courseId: string
  - sectionId: string
  - title: string
  - content: string
  - pageNumber: number
  - timestampStart: number
  - timestampEnd: number
  - orderIndex: number
  - embeddings: number[]
  --
  + getContent(): string
  + getDeepLink(): string
  + getRelatedQuestions(): Question[]
}

class CourseVersion {
  - id: string
  - courseId: string
  - versionNumber: number
  - changesSummary: string
  - requiresSeriesRegeneration: boolean
  - updatedAt: Date
  - updatedBy: string
  --
  + compare(otherVersion): VersionDiff
}

class CourseProgress {
  - id: string
  - userId: string
  - courseId: string
  - completedSections: string[]
  - totalSections: number
  - progressPercentage: number
  - lastAccessedAt: Date
  --
  + updateProgress(): void
  + isCompleted(): boolean
}

' ============================================
' ATTEMPTS & SCORING
' ============================================

class SeriesAttempt {
  - id: string
  - userId: string
  - seriesId: string
  - score: number
  - percentage: number
  - timeTaken: number
  - completedAt: Date
  - isPassed: boolean
  --
  + calculateScore(): number
  + getAnswerDetails(): AttemptAnswer[]
  + generateReport(): SeriesReport
  + identifyWeakConcepts(): string[]
}

class ExamAttempt {
  - id: string
  - userId: string
  - examId: string
  - score: number
  - percentage: number
  - timeTaken: number
  - completedAt: Date
  - isPassed: boolean
  --
  + calculateScore(): number
  + getAnswerDetails(): AttemptAnswer[]
  + generateReport(): ExamReport
}

class AttemptAnswer {
  - id: string
  - attemptId: string
  - questionId: string
  - selectedAnswerIds: string[]
  - isCorrect: boolean
  - pointsEarned: number
  - timeSpent: number
  --
  + validate(): boolean
  + getExplanationWithReferences(): ExplanationResult
}

' ============================================
' AI BATCH GENERATION
' ============================================

class AIBatchJob {
  - id: string
  - jobType: BatchJobType
  - topicId: string
  - status: JobStatus
  - inputParams: JSON
  - outputSummary: JSON
  - startedAt: Date
  - completedAt: Date
  - errorMessage: string
  - createdBy: string
  --
  + execute(): void
  + cancel(): void
  + retry(): void
  + getProgress(): number
}

enum BatchJobType {
  SERIES_GENERATION
  SERIES_REGENERATION
  EXPLANATION_UPDATE
  EMBEDDING_GENERATION
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

class AIGeneratedSeries {
  - id: string
  - batchJobId: string
  - topicId: string
  - seriesType: AISeriesType
  - difficulty: Difficulty
  - questionCount: number
  - generatedAt: Date
  - isApproved: boolean
  - approvedBy: string
  --
  + generateQuestions(): Question[]
  + buildProgressivePath(): LearningPath
  + validate(): boolean
  + publish(): void
}

enum AISeriesType {
  PROGRESSIVE_LEARNING
  WEAK_AREA_FOCUS
  COMPREHENSIVE_REVIEW
  MENTAL_MAP_BUILDER
}

' ============================================
' PROGRESSIVE LEARNING PATH
' ============================================

class LearningPath {
  - id: string
  - seriesId: string
  - topicId: string
  - totalSteps: number
  - estimatedDuration: number
  --
  + getSteps(): PathStep[]
  + getNextStep(currentStep): PathStep
  + trackProgress(userId): PathProgress
  + generateMentalMap(): MentalMap
}

class PathStep {
  - id: string
  - pathId: string
  - stepNumber: number
  - title: string
  - conceptsCovered: string[]
  - prerequisiteSteps: number[]
  - questionIds: string[]
  - courseSectionIds: string[]
  --
  + isUnlocked(userProgress): boolean
  + getQuestions(): Question[]
  + getCourseSections(): CourseSection[]
}

class MentalMap {
  - id: string
  - userId: string
  - topicId: string
  - completionPercentage: number
  - lastUpdated: Date
  --
  + getNodes(): MapNode[]
  + getConnections(): MapConnection[]
  + addNode(concept): void
  + connectNodes(from, to): void
  + visualize(): JSON
}

class MapNode {
  - id: string
  - mentalMapId: string
  - concept: string
  - courseSectionId: string
  - masteryLevel: number
  - position: JSON
  --
  + updateMastery(score): void
}

class MapConnection {
  - id: string
  - mentalMapId: string
  - fromNodeId: string
  - toNodeId: string
  - connectionType: ConnectionType
  - strength: number
  --
  + strengthen(): void
}

enum ConnectionType {
  PREREQUISITE
  RELATED
  CONSEQUENCE
  DIFFERENTIAL
}

' ============================================
' VECTOR EMBEDDINGS
' ============================================

class VectorEmbedding {
  - id: string
  - contentId: string
  - contentType: EmbeddingContentType
  - embedding: number[]
  - metadata: JSON
  - createdAt: Date
  --
  + search(query): VectorEmbedding[]
  + calculateSimilarity(other): number
}

enum EmbeddingContentType {
  COURSE_SECTION
  QUESTION
  EXPLANATION
}

' ============================================
' ANALYTICS & PROGRESS
' ============================================

class UserProgress {
  - id: string
  - userId: string
  - specialtyId: string
  - totalExamsTaken: number
  - averageScore: number
  - bestScore: number
  - totalTimeSpent: number
  - weakTopics: string[]
  - strongTopics: string[]
  - lastActivityAt: Date
  --
  + updateProgress(): void
  + getWeakTopics(): string[]
  + getRecommendations(): Recommendation[]
}

class Analytics {
  - id: string
  - userId: string
  - date: Date
  - examsCompleted: number
  - averageScore: number
  - timeSpent: number
  - topicsStudied: string[]
  --
  + generateReport(): AnalyticsReport
  + compareWithPeers(): PeerComparison
}

' ============================================
' RELATIONSHIPS
' ============================================

User "1" -- "1" Subscription
User "1" -- "*" SeriesAttempt
User "1" -- "*" ExamAttempt
User "1" -- "*" UserProgress
User "1" -- "*" CourseProgress
User "1" -- "*" Analytics
User "1" -- "*" MentalMap

Specialty "1" -- "*" Topic
Specialty "1" -- "*" Course
Specialty "1" -- "*" Exam

Topic "1" -- "*" Series
Topic "1" -- "*" Course
Topic "1" -- "*" LearningPath

Series "1" -- "*" Question
Series "1" -- "*" SeriesAttempt

Exam "1" -- "*" Question
Exam "1" -- "*" ExamAttempt

Question "1" -- "*" Answer
Question "1" -- "*" QuestionCourseReference
Question "1" -- "*" AttemptAnswer

Answer "1" -- "1" AnswerExplanation

AnswerExplanation "*" -- "*" CourseSection : references

QuestionCourseReference "*" -- "1" CourseSection

Course "1" -- "*" CourseSection
Course "1" -- "*" CourseVersion
Course "1" -- "*" CourseProgress

CourseSection "1" -- "1" VectorEmbedding

SeriesAttempt "1" -- "*" AttemptAnswer
ExamAttempt "1" -- "*" AttemptAnswer

AIBatchJob "1" -- "*" AIGeneratedSeries
AIGeneratedSeries "1" -- "1" Series : creates
AIGeneratedSeries "1" -- "1" LearningPath : generates

LearningPath "1" -- "*" PathStep
PathStep "*" -- "*" CourseSection : references

MentalMap "1" -- "*" MapNode
MentalMap "1" -- "*" MapConnection

@enduml
