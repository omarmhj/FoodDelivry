@startuml Medical Exam Platform - Class Diagram

' ============================================
' CORE ENTITIES
' ============================================

class User {
  - id: string
  - email: string
  - passwordHash: string
  - name: string
  - university: University
  - yearOfStudy: number
  - subscriptionTier: SubscriptionTier
  - profileImage: string
  - isActive: boolean
  - createdAt: Date
  - updatedAt: Date
  --
  + register(): void
  + login(): string
  + updateProfile(): void
  + getProgress(): UserProgress
  + getSubscription(): Subscription
}

enum SubscriptionTier {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum University {
  TUNIS
  SOUSSE
  MONASTIR
  SFAX
  OTHER
}

class Subscription {
  - id: string
  - userId: string
  - tier: SubscriptionTier
  - startDate: Date
  - endDate: Date
  - isActive: boolean
  - autoRenew: boolean
  - paymentMethod: string
  --
  + renew(): void
  + cancel(): void
  + upgrade(): void
  + isExpired(): boolean
}

' ============================================
' EXAM DOMAIN (SERIES STRUCTURE)
' ============================================

class Specialty {
  - id: string
  - name: string
  - slug: string
  - description: string
  - iconUrl: string
  - totalTopics: number
  - totalSeries: number
  - orderIndex: number
  --
  + getTopics(): Topic[]
  + getStatistics(): SpecialtyStats
}

class Topic {
  - id: string
  - specialtyId: string
  - name: string
  - slug: string
  - description: string
  - orderIndex: number
  - totalSeries: number
  - estimatedStudyHours: number
  --
  + getSeries(): Series[]
  + getHistoricalSeries(): Series[]
  + getAIGeneratedSeries(): Series[]
}

class Series {
  - id: string
  - topicId: string
  - title: string
  - seriesType: SeriesType
  - university: University
  - year: number
  - difficulty: Difficulty
  - totalQuestions: number
  - durationMinutes: number
  - isPublished: boolean
  - createdAt: Date
  --
  + getQuestions(): Question[]
  + calculateScore(answers): number
  + getStatistics(): SeriesStats
}

enum SeriesType {
  HISTORICAL
  AI_GENERATED
  AI_PROGRESSIVE
}

class Exam {
  - id: string
  - title: string
  - examType: ExamType
  - specialtyId: string
  - university: University
  - year: number
  - durationMinutes: number
  - totalQuestions: number
  - passingScore: number
  - difficulty: Difficulty
  - isPublished: boolean
  - createdAt: Date
  --
  + getQuestions(): Question[]
  + calculateScore(answers): number
  + validateAttempt(): boolean
  + getStatistics(): ExamStats
}

enum ExamType {
  CONCOURS_RESIDANAT
  PRACTICE_EXAM
  MOCK_EXAM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

class Question {
  - id: string
  - parentId: string
  - parentType: QuestionParentType
  - questionText: string
  - questionType: QuestionType
  - imageUrl: string
  - explanation: string
  - difficulty: Difficulty
  - tags: string[]
  - orderIndex: number
  - points: number
  - relatedLessonIds: string[]
  --
  + getAnswers(): Answer[]
  + validateAnswer(userAnswer): boolean
  + getCorrectAnswers(): Answer[]
  + getRelatedLessons(): Lesson[]
}

enum QuestionParentType {
  SERIES
  EXAM
  AI_GENERATED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

class Answer {
  - id: string
  - questionId: string
  - answerText: string
  - isCorrect: boolean
  - explanation: string
  - orderIndex: number
  --
  + validate(): boolean
}

class SeriesAttempt {
  - id: string
  - userId: string
  - seriesId: string
  - score: number
  - percentage: number
  - timeTaken: number
  - answersJson: JSON
  - completedAt: Date
  - isPassed: boolean
  --
  + calculateScore(): number
  + getAnswerDetails(): AttemptAnswer[]
  + generateReport(): SeriesReport
  + identifyWeakConcepts(): string[]
}

class ExamAttempt {
  - id: string
  - userId: string
  - examId: string
  - score: number
  - percentage: number
  - timeTaken: number
  - answersJson: JSON
  - completedAt: Date
  - isPassed: boolean
  --
  + calculateScore(): number
  + getAnswerDetails(): AttemptAnswer[]
  + generateReport(): ExamReport
}

class AttemptAnswer {
  - id: string
  - attemptId: string
  - questionId: string
  - selectedAnswerIds: string[]
  - isCorrect: boolean
  - pointsEarned: number
  - timeSpent: number
  --
  + validate(): boolean
}

' ============================================
' COURSE DOMAIN
' ============================================

class Course {
  - id: string
  - specialtyId: string
  - title: string
  - description: string
  - thumbnailUrl: string
  - difficulty: Difficulty
  - estimatedHours: number
  - isPublished: boolean
  - createdAt: Date
  --
  + getModules(): CourseModule[]
  + getProgress(userId): CourseProgress
  + enroll(userId): void
}

class CourseModule {
  - id: string
  - courseId: string
  - title: string
  - description: string
  - orderIndex: number
  - durationMinutes: number
  --
  + getLessons(): Lesson[]
  + markComplete(userId): void
}

class Lesson {
  - id: string
  - moduleId: string
  - title: string
  - contentType: ContentType
  - content: string
  - videoUrl: string
  - pdfUrl: string
  - orderIndex: number
  - embeddings: number[]
  --
  + getContent(): string
  + markComplete(userId): void
  + getRelatedQuestions(): Question[]
}

enum ContentType {
  TEXT
  VIDEO
  PDF
  INTERACTIVE
}

class CourseProgress {
  - id: string
  - userId: string
  - courseId: string
  - completedLessons: number
  - totalLessons: number
  - progressPercentage: number
  - lastAccessedAt: Date
  --
  + updateProgress(): void
  + isCompleted(): boolean
}

' ============================================
' AI/LLM DOMAIN
' ============================================

class AIInteraction {
  - id: string
  - userId: string
  - interactionType: AIInteractionType
  - questionId: string
  - userInput: string
  - aiResponse: string
  - courseReferences: string[]
  - timestamp: Date
  - feedbackRating: number
  --
  + generateResponse(): string
  + getCourseReferences(): Course[]
  + saveFeedback(rating): void
}

enum AIInteractionType {
  ANSWER_CORRECTION
  STUDY_ASSISTANT
  EXAM_GENERATION
  CONCEPT_EXPLANATION
}

class AIGeneratedSeries {
  - id: string
  - userId: string
  - topicId: string
  - seriesType: AISeriesType
  - difficulty: Difficulty
  - questionCount: number
  - learningPath: JSON
  - generatedAt: Date
  - isApproved: boolean
  --
  + generateQuestions(): Question[]
  + buildProgressivePath(): LearningPath
  + validate(): boolean
  + publish(): void
}

enum AISeriesType {
  PROGRESSIVE_LEARNING
  WEAK_AREA_FOCUS
  COMPREHENSIVE_REVIEW
  MENTAL_MAP_BUILDER
}

class LearningPath {
  - id: string
  - seriesId: string
  - topicId: string
  - pathSteps: PathStep[]
  - totalSteps: number
  - estimatedDuration: number
  --
  + getNextStep(currentStep): PathStep
  + trackProgress(userId): PathProgress
  + generateMentalMap(): MentalMap
}

class PathStep {
  - id: string
  - pathId: string
  - stepNumber: number
  - lessonId: string
  - questionIds: string[]
  - conceptsCovered: string[]
  - prerequisiteSteps: number[]
  --
  + isUnlocked(userProgress): boolean
  + getQuestions(): Question[]
  + getLesson(): Lesson
}

class MentalMap {
  - id: string
  - userId: string
  - topicId: string
  - nodes: MapNode[]
  - connections: MapConnection[]
  - completionPercentage: number
  - lastUpdated: Date
  --
  + addNode(concept): void
  + connectNodes(from, to): void
  + visualize(): JSON
  + export(): string
}

class MapNode {
  - id: string
  - concept: string
  - lessonId: string
  - masteryLevel: number
  - position: JSON
  --
  + updateMastery(score): void
}

class MapConnection {
  - id: string
  - fromNodeId: string
  - toNodeId: string
  - connectionType: ConnectionType
  - strength: number
  --
  + strengthen(): void
}

enum ConnectionType {
  PREREQUISITE
  RELATED
  CONSEQUENCE
  DIFFERENTIAL
}

class VectorEmbedding {
  - id: string
  - contentId: string
  - contentType: string
  - embedding: number[]
  - metadata: JSON
  --
  + search(query): VectorEmbedding[]
  + calculateSimilarity(other): number
}

' ============================================
' ANALYTICS & PROGRESS
' ============================================

class UserProgress {
  - id: string
  - userId: string
  - specialtyId: string
  - totalExamsTaken: number
  - averageScore: number
  - bestScore: number
  - totalTimeSpent: number
  - weakTopics: string[]
  - strongTopics: string[]
  - lastActivityAt: Date
  --
  + updateProgress(): void
  + getWeakTopics(): string[]
  + getRecommendations(): Recommendation[]
}

class Analytics {
  - id: string
  - userId: string
  - date: Date
  - examsCompleted: number
  - averageScore: number
  - timeSpent: number
  - topicsStudied: string[]
  --
  + generateReport(): AnalyticsReport
  + compareWithPeers(): PeerComparison
}

class Leaderboard {
  - id: string
  - specialtyId: string
  - university: University
  - period: LeaderboardPeriod
  - updatedAt: Date
  --
  + getTopUsers(limit): LeaderboardEntry[]
  + getUserRank(userId): number
  + refresh(): void
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

class LeaderboardEntry {
  - userId: string
  - userName: string
  - score: number
  - rank: number
  - university: University
  --
  + getUser(): User
}

' ============================================
' STUDY PLAN & RECOMMENDATIONS
' ============================================

class StudyPlan {
  - id: string
  - userId: string
  - specialtyId: string
  - startDate: Date
  - endDate: Date
  - targetScore: number
  - isActive: boolean
  --
  + generatePlan(): StudyPlanItem[]
  + updateProgress(): void
  + adjustPlan(): void
}

class StudyPlanItem {
  - id: string
  - studyPlanId: string
  - itemType: StudyItemType
  - contentId: string
  - scheduledDate: Date
  - isCompleted: boolean
  - priority: Priority
  --
  + markComplete(): void
  + reschedule(date): void
}

enum StudyItemType {
  EXAM
  COURSE
  LESSON
  REVISION
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

class Recommendation {
  - id: string
  - userId: string
  - recommendationType: RecommendationType
  - contentId: string
  - reason: string
  - priority: Priority
  - createdAt: Date
  --
  + accept(): void
  + dismiss(): void
}

enum RecommendationType {
  EXAM
  COURSE
  TOPIC_REVISION
  WEAK_AREA_FOCUS
}

' ============================================
' NOTIFICATIONS
' ============================================

class Notification {
  - id: string
  - userId: string
  - type: NotificationType
  - title: string
  - message: string
  - isRead: boolean
  - actionUrl: string
  - createdAt: Date
  --
  + markAsRead(): void
  + send(): void
}

enum NotificationType {
  EXAM_REMINDER
  STUDY_PLAN_UPDATE
  NEW_CONTENT
  ACHIEVEMENT
  SUBSCRIPTION_EXPIRY
}

' ============================================
' RELATIONSHIPS
' ============================================

User "1" -- "1" Subscription
User "1" -- "*" ExamAttempt
User "1" -- "*" UserProgress
User "1" -- "*" CourseProgress
User "1" -- "*" AIInteraction
User "1" -- "*" StudyPlan
User "1" -- "*" Notification
User "1" -- "*" Analytics

Specialty "1" -- "*" Topic
Specialty "1" -- "*" Course
Specialty "1" -- "*" UserProgress
Specialty "1" -- "*" Exam

Topic "1" -- "*" Series
Topic "1" -- "*" LearningPath

Series "1" -- "*" Question
Series "1" -- "*" SeriesAttempt

Exam "1" -- "*" Question
Exam "1" -- "*" ExamAttempt

Question "1" -- "*" Answer
Question "1" -- "*" AttemptAnswer
Question "*" -- "*" Lesson : relatedTo

SeriesAttempt "1" -- "*" AttemptAnswer
ExamAttempt "1" -- "*" AttemptAnswer

AIGeneratedSeries "1" -- "1" Series : creates
AIGeneratedSeries "1" -- "1" LearningPath : generates

LearningPath "1" -- "*" PathStep

MentalMap "1" -- "*" MapNode
MentalMap "1" -- "*" MapConnection

User "1" -- "*" SeriesAttempt
User "1" -- "*" MentalMap

Course "1" -- "*" CourseModule
Course "1" -- "*" CourseProgress

CourseModule "1" -- "*" Lesson

Lesson "1" -- "1" VectorEmbedding

AIInteraction "*" -- "*" Lesson : references

StudyPlan "1" -- "*" StudyPlanItem

Leaderboard "1" -- "*" LeaderboardEntry

AIGeneratedExam "1" -- "*" Question : generates

@enduml
