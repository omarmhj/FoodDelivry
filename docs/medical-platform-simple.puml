@startuml Medical Exam Platform - Simplified

' ============================================
' USER & AUTH
' ============================================

class User {
  - id: string
  - email: string
  - name: string
  - university: string
  - subscriptionTier: string
}

' ============================================
' CONTENT HIERARCHY
' ============================================

class Specialty {
  - id: string
  - name: string
}

class Topic {
  - id: string
  - specialtyId: string
  - name: string
}

class Series {
  - id: string
  - topicId: string
  - title: string
  - type: string
  - university: string
  - year: number
}

' ============================================
' QUESTIONS & ANSWERS
' ============================================

class Question {
  - id: string
  - seriesId: string
  - text: string
  - explanation: string
  - courseReferences: JSON
}

class Answer {
  - id: string
  - questionId: string
  - text: string
  - isCorrect: boolean
}

' ============================================
' COURSES
' ============================================

class Course {
  - id: string
  - topicId: string
  - title: string
  - content: JSON
  - version: number
}

' ============================================
' USER ACTIVITY
' ============================================

class Attempt {
  - id: string
  - userId: string
  - seriesId: string
  - score: number
  - answers: JSON
  - completedAt: Date
}

' ============================================
' AI GENERATION
' ============================================

class BatchJob {
  - id: string
  - topicId: string
  - status: string
  - createdAt: Date
}

' ============================================
' RELATIONSHIPS
' ============================================

Specialty "1" -- "*" Topic
Topic "1" -- "*" Series
Topic "1" -- "*" Course
Series "1" -- "*" Question
Question "1" -- "*" Answer
Question "*" -- "*" Course : references
User "1" -- "*" Attempt
Attempt "*" -- "1" Series
BatchJob "1" -- "*" Series : generates

@enduml
